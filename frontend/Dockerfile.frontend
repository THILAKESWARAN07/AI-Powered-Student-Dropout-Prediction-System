# Use official Node base image (matching host version)
FROM node:22-alpine

# Set working directory
WORKDIR /workspace

# Copy dependency files
COPY package*.json /workspace/

# Install dependencies
RUN npm install

# Copy project files
COPY . /workspace/

# Expose Vite dev server port
EXPOSE 5173

# Start Vite dev server in host mode for container accessibility
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
